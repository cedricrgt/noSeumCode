# ----------------------------------------------------------------------
# Force HTTPS
# ----------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----------------------------------------------------------------------
# Redirection "En construction" (supprimer ce bloc quand le site est prêt)
# ----------------------------------------------------------------------
# RewriteCond %{REMOTE_ADDR} !^12\.34\.56\.78$
# RewriteCond %{REQUEST_URI} !/en-construction\.html$
# RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf|json)$ [NC]
# RewriteRule ^(.*)$ /en-construction.html [R=503,L]

# Indiquer à Apache d'utiliser la page en-construction.html pour l'erreur 503
# ErrorDocument 503 /en-construction.html


# ----------------------------------------------------------------------
# Browser Caching (Standard)
# ----------------------------------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # HTML
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS/JS
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    
    # Images
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

# ----------------------------------------------------------------------
# Security & Clean URLs
# ----------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

# ----------------------------------------------------------------------
# HTTP Security Headers
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Enforce HTTPS for 1 year (includeSubDomains)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Control referrer information sent to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Limit browser features / APIs available to the page
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy
    # Adjust script-src and style-src if you add more CDNs / inline scripts
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://noseumcode.fr https://api.noseumcode.fr; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
</IfModule>
