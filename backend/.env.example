# ========================================================
# NoSeumCode - Backend Environment Variables Template (.env.example)
# ========================================================

# Base de données PostgreSQL
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
DB_URL=jdbc:postgresql://localhost:5432/<DB_NAME>
DB_USERNAME=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# Sécurité & Tokens JWT
JWT_SECRET=<YOUR_SUPER_SECRET_KEY_AT_LEAST_256_BITS>
JWT_EXPIRY_HOURS=24

# Compte Administrateur Initial (optionnel au premier démarrage)
ADMIN_EMAIL=admin@codebangers.fr
ADMIN_PASSWORD=<ADMIN_PASSWORD>

# OAuth2 Social Providers
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

GITHUB_CLIENT_ID=<GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>

FACEBOOK_CLIENT_ID=<FACEBOOK_CLIENT_ID>
FACEBOOK_CLIENT_SECRET=<FACEBOOK_CLIENT_SECRET>

DISCORD_CLIENT_ID=<DISCORD_CLIENT_ID>
DISCORD_CLIENT_SECRET=<DISCORD_CLIENT_SECRET>

# Redirection Frontend & CORS
FRONTEND_DASHBOARD_URL=http://localhost:3000/dashboard.html
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
