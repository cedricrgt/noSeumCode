# ----------------------------------------------------------------------
# Force HTTPS
# ----------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----------------------------------------------------------------------
# Digital Asset Links & .well-known Exemption (no rewrites/redirects)
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
RewriteRule ^ - [L]

# ----------------------------------------------------------------------
# Robots.txt Staging Isolation (develop.noseumcode.fr)
# ----------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^develop\.noseumcode\.fr$ [NC]
RewriteRule ^robots\.txt$ robots-dev.txt [L]

# ----------------------------------------------------------------------
# API Route Redirection to Backend (Oracle Cloud VM API)
# Redirects /api/* requests on static frontend host to https://api.noseumcode.fr
# Preserves HTTP methods (POST, GET, PUT, PATCH, DELETE) and query strings via 307.
# ----------------------------------------------------------------------
RewriteRule ^api/(.*)$ https://api.noseumcode.fr/api/$1 [R=307,L,QSA]

# ----------------------------------------------------------------------
# Clean URLs & Route Rewrites (Sprint 6 / ADR-013 & ADR-014)
# ----------------------------------------------------------------------
# 1. Redirection 301 de l'ancienne route /cours et /cours.html vers /parcours
RewriteRule ^cours/?$ /parcours [R=301,L,QSA]
RewriteRule ^cours\.html$ /parcours [R=301,L,QSA]

# 2. Réécriture propre de l'endpoint /parcours vers parcours.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^parcours/?$ parcours.html [L,QSA]

# 3. Réécriture propre des formations statiques (Sprint 8 / ADR-013)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^formations/starter/?$ formations/starter.html [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^formations/pack-web/?$ formations/pack-web.html [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^formations/?$ formations/index.html [L,QSA]

# 4. Réécriture propre des pages légales (Sprint 13)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^mentions-legales/?$ mentions-legales.html [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cgv/?$ cgv.html [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^confidentialite/?$ confidentialite.html [L,QSA]

RewriteRule ^politique-confidentialite(\.html)?$ /confidentialite.html [R=301,L]

# 5. Réécriture propre du blog (Sprint 16 & Cocon Sémantique)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog/$1.html [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/?$ index.html#blog [L,QSA]

# 6. Réécriture propre Suivi Mentor
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^suivi-mentor/?$ suivi-mentor.html [L,QSA]


# ----------------------------------------------------------------------
# Redirection "En construction" (supprimer ce bloc quand le site est prêt)
# ----------------------------------------------------------------------
# RewriteCond %{REMOTE_ADDR} !^12\.34\.56\.78$
# RewriteCond %{REQUEST_URI} !/en-construction\.html$
# RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf|json)$ [NC]
# RewriteRule ^(.*)$ /en-construction.html [R=503,L]

# Indiquer à Apache d'utiliser la page en-construction.html pour l'erreur 503
# ErrorDocument 503 /en-construction.html


# ----------------------------------------------------------------------
# Compression GZIP / Deflate (Sprint 8 - Performance Core Web Vitals)
# ----------------------------------------------------------------------

<IfModule mod_deflate.c>
    # Activer la compression pour tous les types de contenus textuels
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom_xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/eot
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2

    # Éviter les bugs avec les anciens navigateurs
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    Header append Vary User-Agent env=!dont-vary
</IfModule>


# ----------------------------------------------------------------------
# Browser Caching & Expiration (Sprint 8 - WebP, AVIF, Fonts, CSS, JS)
# ----------------------------------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Documents HTML (toujours revalidés pour un déploiement instantané)
    ExpiresByType text/html "access plus 0 seconds"
    
    # Feuilles de styles et scripts
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Images modernes et médias
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    
    # Polices web (Web Fonts WOFF2 / WOFF)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # Données et flux
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Caching headers pour les assets statiques et immuables
    <FilesMatch "\.(ico|webp|avif|png|jpe?g|gif|svg|woff2?|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Security & Clean URLs
# ----------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

# Block access to hidden files and directories (dotfiles), except .well-known
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteRule "(^|/)\." - [F]
</IfModule>

# Block direct HTTP access to build scripts, package manifests, and markdown docs
<FilesMatch "^(package(-lock)?\.json|build\.(sh|ps1|js)|README\.md|\.env.*)$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# HTTP Security Headers
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
    # Digital Asset Links JSON header & CORS allowlist
    <Files "assetlinks.json">
        Header set Content-Type "application/json; charset=utf-8"
        Header set Access-Control-Allow-Origin "*"
    </Files>

    # Do not index develop subdomain
    SetEnvIfNoCase Host "^develop\.noseumcode\.fr$" IS_DEV_SUBDOMAIN
    Header set X-Robots-Tag "noindex, nofollow, noarchive" env=IS_DEV_SUBDOMAIN

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Enforce HTTPS for 1 year (includeSubDomains)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Control referrer information sent to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Limit browser features / APIs available to the page
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\")"

    # Content Security Policy
    # Allows Stripe.js, embedded checkout iframes, HubSpot forms & scripts, API connections, and cookieless Analytics (Plausible/Umami)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://js-eu1.hsforms.net https://js.hsforms.net https://plausible.io https://cloud.umami.is; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://forms.eu1.hsforms.com https://forms-eu1.hsforms.com https://forms.hubspot.com https://forms.hsforms.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: https://*.stripe.com https://forms.hubspot.com https://forms-eu1.hsforms.com; connect-src 'self' https://noseumcode.fr https://api.noseumcode.fr https://develop.noseumcode.fr http://localhost:8080 http://localhost:3000 https://api.stripe.com https://api.hsforms.com https://forms.hubspot.com https://forms-eu1.hsforms.com https://forms.hsforms.com https://api-eu1.hubspot.com https://api.hubspot.com https://plausible.io https://cloud.umami.is https://api-gateway.umami.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://forms.hubspot.com https://forms-eu1.hsforms.com https://forms.hsforms.com;"
</IfModule>
